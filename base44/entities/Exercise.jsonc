{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "catalogKey": { "type": "string" },
    "catalogVersion": { "type": "number" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "movementPattern": { "type": "string" },
    "difficulty": { "type": "string" },
    "trainingFocus": { "type": "string" },
    "programEligible": { "type": "boolean" },
    "selectionPriority": { "type": "number" },
    "instructions": { "type": "array", "items": { "type": "string" } },
    "coachingRecommended": { "type": "boolean" },
    "name": {
      "type": "string"
    },
    "primaryMuscle": {
      "type": "string"
    },
    "secondaryMuscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipment": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "repMin": {
      "type": "number"
    },
    "repMax": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "primaryMuscle"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
