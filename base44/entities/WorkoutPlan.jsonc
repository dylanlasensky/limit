{
  "name": "WorkoutPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "daysPerWeek": {
      "type": "number"
    },
    "programType": {
      "type": "string"
    },
    "sessionDurationTarget": {
      "type": "number"
    },
    "priorityMuscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "limit_generated",
        "pasted_text",
        "uploaded_file",
        "manual"
      ]
    },
    "sport": {
      "type": "string"
    },
    "seasonPhase": {
      "type": "string",
      "enum": [
        "in_season",
        "off_season",
        "pre_season",
        "not_applicable"
      ]
    },
    "coachProvided": {
      "type": "boolean"
    },
    "athleteMode": {
      "type": "string",
      "enum": [
        "track_only",
        "smart_progression",
        "accessory_suggestions"
      ]
    },
    "structureLocked": {
      "type": "boolean"
    },
    "importNotes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}