{
  "name": "HealthMetric",
  "type": "object",
  "properties": {
    "date": { "type": "string", "format": "date" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "metric": {
      "type": "string",
      "enum": [
        "steps",
        "active_calories",
        "distance",
        "exercise_minutes",
        "sleep_duration",
        "sleep_score",
        "resting_heart_rate",
        "heart_rate_variability",
        "respiratory_rate",
        "oxygen_saturation",
        "readiness_score",
        "stress_score",
        "weight",
        "body_fat",
        "fat_mass",
        "lean_body_mass",
        "skeletal_muscle_mass",
        "body_water",
        "bone_mass",
        "visceral_fat",
        "waist_circumference",
        "hip_circumference"
      ]
    },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "limit",
        "apple_health",
        "health_connect",
        "oura",
        "whoop",
        "garmin",
        "fitbit",
        "withings",
        "other"
      ]
    },
    "sourceRecordId": { "type": "string", "maxLength": 240 },
    "sourceDevice": { "type": "string", "maxLength": 120 },
    "aggregation": {
      "type": "string",
      "enum": ["daily", "sample"],
      "default": "daily"
    },
    "importedAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "required": ["date", "metric", "value", "unit", "source"],
  "rls": {
    "read": { "created_by_id": "{{user.id}}" },
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
