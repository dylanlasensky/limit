{
  "name": "WorkoutSession",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string"
    },
    "workoutDayId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMinutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "skipped"
      ]
    },
    "targetMuscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "totalVolume": {
      "type": "number"
    },
    "setCount": {
      "type": "number"
    },
    "prCount": {
      "type": "number"
    },
    "completionSummary": {
      "type": "object"
    },
    "analyticsStatus": {
      "type": "string",
      "enum": [
        "pending",
        "complete"
      ]
    }
  },
  "required": [
    "name",
    "date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerId": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}