{
  "name": "HealthPreference",
  "type": "object",
  "properties": {
    "hiddenMetrics": {
      "type": "array",
      "maxItems": 22,
      "items": {
        "type": "string",
        "enum": [
          "steps",
          "active_calories",
          "distance",
          "exercise_minutes",
          "sleep_duration",
          "sleep_score",
          "resting_heart_rate",
          "heart_rate_variability",
          "respiratory_rate",
          "oxygen_saturation",
          "readiness_score",
          "stress_score",
          "weight",
          "body_fat",
          "fat_mass",
          "lean_body_mass",
          "skeletal_muscle_mass",
          "body_water",
          "bone_mass",
          "visceral_fat",
          "waist_circumference",
          "hip_circumference",
        ],
      },
    },
    "preferredSources": { "type": "object" },
  },
  "required": ["hiddenMetrics", "preferredSources"],
  "rls": {
    "read": { "created_by_id": "{{user.id}}" },
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" },
  },
}
