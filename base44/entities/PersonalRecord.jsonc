{
  "name": "PersonalRecord",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string"
    },
    "workoutSessionId": {
      "type": "string"
    },
    "exerciseId": {
      "type": "string"
    },
    "exerciseName": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "weight": {
      "type": "number"
    },
    "reps": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "exerciseName",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerId": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}