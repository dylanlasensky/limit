{
  "name": "ExerciseSet",
  "type": "object",
  "properties": {
    "workoutSessionId": {
      "type": "string"
    },
    "exerciseId": {
      "type": "string"
    },
    "exerciseName": {
      "type": "string"
    },
    "primaryMuscle": {
      "type": "string"
    },
    "setNumber": {
      "type": "number"
    },
    "setType": {
      "type": "string",
      "enum": [
        "working",
        "warmup",
        "drop",
        "failure"
      ],
      "default": "working"
    },
    "weight": {
      "type": "number"
    },
    "reps": {
      "type": "number"
    },
    "rir": {
      "type": "number"
    },
    "completed": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workoutSessionId",
    "exerciseName",
    "setNumber"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}