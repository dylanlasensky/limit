{
  "name": "limit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-design-tokens.mjs && vite build && node scripts/build-offline.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "check:release-source": "node scripts/check-app-store-readiness.mjs --code-only",
    "check:app-store": "node scripts/check-app-store-readiness.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "worker:types": "wrangler types --env preview --strict-vars=false",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-d1.mjs worker/seed.sql && wrangler d1 execute DB --local --file worker/seed.sql",
    "test:api": "node --test tests/api/*.test.mjs",
    "postinstall": "node scripts/patch-native-decoder.mjs",
    "test:native": "node --test tests/native/*.test.mjs",
    "security:check": "node scripts/secret-scan.mjs && node scripts/verify-braces-fork.mjs && node scripts/security-audit.mjs",
    "media:check": "node scripts/media/validate.mjs",
    "media:review": "node scripts/media/review.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.84.1",
    "better-auth": "^1.7.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "13.5.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.3",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "braces": "file:vendor/braces",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "react-native-reanimated": "4.5.1",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0",
    "vite": "8.3.2",
    "vitest": "^5.0.0",
    "wrangler": "4.146.0"
  },
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "overrides": {
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0",
    "braces": "$braces",
    "sharp": "0.35.5",
    "postcss-selector-parser": "7.1.6",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "rolldown": "1.2.11"
  }
}
