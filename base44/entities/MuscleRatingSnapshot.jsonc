{
  "name": "MuscleRatingSnapshot",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "workoutSessionId": {
      "type": "string"
    },
    "overallLevel": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "Elite"
      ]
    },
    "overallScore": {
      "type": "number"
    },
    "muscleScores": {
      "type": "object"
    },
    "muscleLevels": {
      "type": "object"
    },
    "confidence": {
      "type": "object"
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "date",
    "overallLevel",
    "overallScore"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.ownerId": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}